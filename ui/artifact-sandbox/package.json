{
  "name": "@demios-desktop/artifact-sandbox",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Sandboxed renderer for Claude-style artifacts (ADR-0004): html, svg, mermaid, markdown, code and React in an opaque-origin iframe.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "serve": "node scripts/serve.mjs",
    "test": "npm run build && playwright test",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "marked": "18.3.0",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
