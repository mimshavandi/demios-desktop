{
  "name": "demios-desktop-ui",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sandbox.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sandbox.mjs",
    "build": "tsc --noEmit -p . && vite build",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "tauri": "tauri",
    "dev:app": "tauri dev --features dev-fake-model",
    "sandbox": "node scripts/sandbox.mjs --force"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "~2.11.1",
    "dompurify": "^3.5.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.79.0",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
