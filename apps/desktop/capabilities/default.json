{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the app's own chat, history and settings commands and drag the window by its title bar; nothing else (no fs, shell or http plugins; the opener plugin is present for Rust-side use but not granted to the webview).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-delete-all-local-data",
    "allow-local-data-summary",
    "allow-report-problem",
    "allow-list-mcp-servers",
    "allow-save-mcp-server",
    "allow-remove-mcp-server",
    "allow-reconnect-mcp-server",
    "allow-sign-in-mcp-server",
    "allow-sign-out-mcp-server",
    "allow-hub-search",
    "allow-hub-repo",
    "allow-hub-pull",
    "allow-hub-cancel",
    "allow-hub-pull-status",
    "allow-hf-token-status",
    "allow-set-hf-token",
    "allow-delete-hf-token",
    "allow-list-conversations",
    "allow-create-conversation",
    "allow-rename-conversation",
    "allow-delete-conversation",
    "allow-list-messages",
    "allow-send-message",
    "allow-regenerate",
    "allow-stop-generation",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-models",
    "allow-set-provider-key",
    "allow-delete-provider-key",
    "allow-restore-conversation",
    "allow-restore-provider-key",
    "allow-watch-tools",
    "allow-respond-approval",
    "allow-list-unknown-outcomes",
    "allow-resolve-unknown-outcome",
    "allow-watch-local-models",
    "allow-download-model",
    "allow-pause-download",
    "core:window:allow-start-dragging"
  ]
}
