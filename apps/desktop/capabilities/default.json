{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call the app's own chat, history and settings commands and drag the window by its title bar; nothing else (no fs, shell, http or opener plugins).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-delete-all-local-data",
    "allow-local-data-summary",
    "allow-report-problem",
    "allow-list-conversations",
    "allow-create-conversation",
    "allow-rename-conversation",
    "allow-delete-conversation",
    "allow-list-messages",
    "allow-send-message",
    "allow-regenerate",
    "allow-stop-generation",
    "allow-get-settings",
    "allow-update-settings",
    "allow-list-models",
    "allow-set-provider-key",
    "allow-delete-provider-key",
    "allow-restore-conversation",
    "allow-restore-provider-key",
    "allow-watch-tools",
    "allow-respond-approval",
    "allow-list-unknown-outcomes",
    "allow-resolve-unknown-outcome",
    "allow-watch-local-models",
    "allow-download-model",
    "allow-pause-download",
    "core:window:allow-start-dragging"
  ]
}
