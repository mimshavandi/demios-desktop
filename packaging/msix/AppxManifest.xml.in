<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for Almend Desktop (T-STORE-04, issue #56).
  build-msix.mjs fills every {{…}} value; the identity values come from identity.json or the
  MSIX_* environment variables (packaging/msix/README.md). Don't put real Partner Center values
  in this file.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Name, Publisher: Partner Center › Product identity › Package/Identity/Name and
       Package/Identity/Publisher, copied exactly. -->
  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <!-- Partner Center: the reserved app name, and Package/Properties/PublisherDisplayName. -->
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>{{DESCRIPTION}}</Description>
  </Properties>

  <Dependencies>
    <!-- 1809 is the oldest Windows 10 release the WebView2 runtime supports. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- A Win32 desktop app (Tauri with WebView2), packaged with the desktop bridge. -->
    <Application
      Id="DemiosDesktop"
      Executable="{{EXECUTABLE}}"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="{{DESCRIPTION}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- demios:// add-model links (deeplink.rs). Installers register the scheme; a release
             build never registers it itself, so the package has to. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="demios">
            <uap:DisplayName>Demios link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- BYOK providers (Anthropic, OpenAI, Gemini), Hugging Face model downloads, HTTP MCP
         servers and their OAuth servers. -->
    <Capability Name="internetClient" />
    <!-- Required by every Win32 desktop bridge app (EntryPoint Windows.FullTrustApplication):
         the app runs as a normal desktop process, not in an AppContainer. It starts local AI
         inference and the local tool servers (MCP) the user configures. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
